SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# No SUPABASE_JWT_SECRET needed — new Supabase projects use ES256 (asymmetric).
# The backend fetches Supabase's public key from the JWKS endpoint automatically.
GEMINI_API_KEY=your-gemini-api-key-here

# App settings
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000